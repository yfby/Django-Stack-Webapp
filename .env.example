# Production only. Local classroom startup needs no .env file.
DJANGO_SETTINGS_MODULE=config.production
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_VALUE_AT_LEAST_50_CHARACTERS_LONG
DJANGO_ALLOWED_HOSTS=desk.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://desk.example.edu
# Set to 1 only after configuring a trusted HTTPS proxy (docs/DEPLOYMENT.md).
DJANGO_TRUST_PROXY=0
POSTGRES_DB=flowdesk
POSTGRES_USER=flowdesk
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=PrintPilot <noreply@example.edu>
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_HOST_USER=REPLACE_ME
EMAIL_HOST_PASSWORD=REPLACE_ME
EMAIL_USE_TLS=1
